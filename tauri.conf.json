{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CondaSrc",
  "version": "0.1.0",
  "identifier": "com.condasrc.app",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CondaSrc — Conda 镜像源切换器",
        "width": 1000,
        "height": 700,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
